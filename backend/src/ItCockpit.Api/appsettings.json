{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ItManagerCockpit;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Hangfire": "Server=localhost;Database=ItManagerCockpit;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Auth": {
    "Provider": "Local",
    "AllowedDomains": [ "menarini.com.tr", "menarini.com" ],
    "GoogleClientId": null,
    "GoogleAuthority": "https://accounts.google.com"
  },
  "Ldap": {
    "Server": "dc.menarini.com.tr",
    "Port": 389,
    "UseSsl": false,
    "SearchBase": "DC=menarini,DC=com,DC=tr",
    "SearchFilter": "(userPrincipalName={0})",
    "BindDn": null,
    "BindPassword": null
  },
  "Clock": {
    "TimeZone": "Europe/Istanbul"
  },
  "Gmail": {
    "Provider": "Mock",
    "MailboxAddress": "ayilmaz@menarini.com.tr",
    "Mailboxes": [],
    "TicketLabel": null,
    "SubjectContains": "New Ticket n.",
    "PollIntervalMinutes": 5,
    "MaxResultsPerRun": 100,
    "InitialLookbackDays": 30,
    "CredentialsPath": "credentials.json",
    "TokenStorePath": "token-store"
  },
  "MockGmail": {
    "FixtureDirectory": "MailFixtures"
  },
  "TicketParser": {
    "AllowedSenders": [ "ticket@menarini.com" ],
    "RequiredSignature": "Service Desk Menarini",
    "DefaultTimeZone": "Europe/Istanbul",
    "ExternalUrlHostHint": "tixcore"
  },
  "Reminders": {
    "Provider": "Mock",
    "FromAddress": "ayilmaz@menarini.com.tr"
  },
  "Hangfire": {
    "EnableServer": true,
    "UseMemoryStorage": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/it-cockpit-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
